{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push origin :*)",
      "Bash(git push * +*)",
      "Bash(git push +*)",
      "Bash(git tag -d*)",
      "Bash(gh release *)",
      "Bash(gh api -X DELETE repos/*/rulesets*)",
      "Bash(gh api -X PUT repos/*/rulesets*)",
      "Bash(gh api -X PATCH repos/*/rulesets*)",
      "Bash(gh api -X DELETE repos/*/branches*)",
      "Bash(gh api -X PUT repos/*/branches*)",
      "Bash(gh api -X PATCH repos/*/branches*)",
      "Bash(gh api -X DELETE repos/*/environments*)",
      "Bash(gh api -X PUT repos/*/environments*)",
      "Bash(gh api -X PATCH repos/*/environments*)",
      "Bash(gh api -X DELETE repos/*/settings*)",
      "Bash(gh api -X PUT repos/*/settings*)",
      "Bash(gh api -X PATCH repos/*/settings*)",
      "Bash(gh api -X DELETE repos/*/hooks*)",
      "Bash(gh api -X PUT repos/*/hooks*)",
      "Bash(gh api -X PATCH repos/*/hooks*)",
      "Bash(gh api -X DELETE repos/*/keys*)",
      "Bash(gh api -X PUT repos/*/keys*)",
      "Bash(gh api -X PATCH repos/*/keys*)",
      "Bash(gh api -X *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api * -X PATCH*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api * --method PUT*)",
      "Bash(gh api * --method PATCH*)",
      "Bash(gh api --method *)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(docker system prune*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm*)"
    ]
  }
}
