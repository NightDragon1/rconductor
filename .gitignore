# Build output
/bin/
/dist/
*.exe
*.test
coverage.out

# Local runtime data and caches
/.cache/
/data/
/secrets/
/backups/

# Frontend (the UI build is embedded from internal/webui/dist; only the
# placeholder is committed so go:embed always finds the directory)
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep
/web/node_modules/
/web/coverage/
/web/test-results/
/web/playwright-report/

# Local only: screenshots for reviews and the handover
/docs/screenshots/
/docs/handover.md
/web/.dist-language/

# Local working rules of Claude Code, not public
/CLAUDE.local.md
/.claude/commands
/.claude/worktrees/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Playwright
/web/e2e/.state-*.json
/web/e2e/.panel-*.log
/web/test-results/
/web/playwright-report/

# Local only: screenshots for reviews and the handover
/docs/screenshots/
/docs/handover.md
/web/.dist-language/
