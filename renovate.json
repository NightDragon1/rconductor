{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "automerge": false,
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Go modules of the panel and agent, including the tools module",
      "matchManagers": ["gomod"],
      "groupName": "Go modules"
    },
    {
      "description": "Go toolchain in go.mod files and the build image",
      "matchDepNames": ["go", "golang"],
      "groupName": "Go toolchain"
    },
    {
      "description": "Web UI dependencies",
      "matchManagers": ["npm"],
      "groupName": "web dependencies"
    },
    {
      "description": "openapi-typescript and typescript-eslint require TypeScript 5",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6"
    },
    {
      "description": "Docker base images",
      "matchManagers": ["dockerfile"],
      "excludeDepNames": ["golang"],
      "groupName": "base images"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The container of the E2E jobs must fit the Playwright package",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "Playwright"
    }
  ]
}
